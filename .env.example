# Application
APP_ENV=development
APP_NAME=Personal AI Telegram Investment Assistant
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO

# Security / single-user access
TELEGRAM_ALLOWED_USER_ID=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# Supabase / PostgreSQL
# Example SQLAlchemy URL:
# postgresql+psycopg://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Dhan
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
DHAN_API_KEY=
DHAN_API_SECRET=
DHAN_API_BASE_URL=https://api.dhan.co
DHAN_AUTH_BASE_URL=https://auth.dhan.co
DHAN_REDIRECT_URL=https://stockbot-rho.vercel.app/api/dhan/callback
DHAN_POSTBACK_URL=https://stockbot-rho.vercel.app/api/dhan/postback

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# News provider is intentionally fixed to Finnhub.
NEWS_PROVIDER=finnhub
FINNHUB_API_KEY=

# Market data
YFINANCE_TIMEOUT_SECONDS=15

# Product defaults
DEFAULT_RISK_PROFILE=Balanced
MONTHLY_INVESTMENT_BUDGET_INR=5000
MONTHLY_INVESTMENT_DAY=12

# Report scheduling labels used by Vercel Cron routes
ENABLE_DAILY_MORNING_REPORT=true
ENABLE_DAILY_CLOSE_REPORT=true
ENABLE_WEEKLY_REPORT=true
ENABLE_MONTHLY_WORKFLOW=true

# Runtime reliability
HTTP_TIMEOUT_SECONDS=20
HTTP_RETRY_ATTEMPTS=3
CRON_SECRET=
